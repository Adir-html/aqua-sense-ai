# ── AquaSense AI — Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── OpenRouter API (primary AI engine — required) ─────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── PostgreSQL Database ────────────────────────────────────────────────────────
# For local dev: use your local PostgreSQL instance
# For Docker:    change localhost to "db" (the docker-compose service name)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aquasense

# Docker Compose DB credentials (must match DATABASE_URL above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aquasense

# ── ONNX Model (offline fallback) ─────────────────────────────────────────────
MODEL_PATH=models/model.onnx
MODEL_FRAMEWORK=onnx

# ── Dataset auto-save path ────────────────────────────────────────────────────
DATASET_PATH=dataset

# ── API authentication (optional) ─────────────────────────────────────────────
# Set this to require x-api-key header on all requests
API_KEY=

# ── CORS allowed origins (optional) ───────────────────────────────────────────
# Comma-separated. Leave blank for localhost dev mode.
# Production example: CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=

# ── Rate limiting (optional) ──────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=60

# ── OpenRouter tuning (optional) ──────────────────────────────────────────────
# Seconds to wait per API attempt before timing out (default: 10)
OPENROUTER_TIMEOUT=10

# ── Alerts (optional) ─────────────────────────────────────────────────────────
# Webhook URL to POST to when a critical issue is detected.
# Compatible with ntfy.sh (free, no signup for basic use):
#   1. Pick a topic name: https://ntfy.sh/your-topic-name
#   2. Install the ntfy app on your phone and subscribe to the topic
#   3. Set ALERT_WEBHOOK_URL=https://ntfy.sh/your-topic-name
ALERT_WEBHOOK_URL=

# ── Kaggle dataset importer ───────────────────────────────────────────────────
KAGGLE_API_TOKEN=your_kgat_token_here

# ── Roboflow dataset importer ─────────────────────────────────────────────────
ROBOFLOW_API_KEY=your_roboflow_api_key_here
