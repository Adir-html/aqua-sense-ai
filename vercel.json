{
  "version": 2,
  "buildCommand": "mkdir -p public && cp -r apps/web/src/. public/",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/auth/:path*", "destination": "/api/index" }
  ]
}
